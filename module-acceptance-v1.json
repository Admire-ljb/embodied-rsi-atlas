    {
      "case_id": "duplicate-handoff",
      "deliveries": [
        {"message_id": "m1", "step_id": "summarize", "refs": ["r1", "r2", "r3"]},
        {"message_id": "m1", "step_id": "summarize", "refs": ["r1", "r2", "r3"]}
      ],
      "expected": {"status": "completed", "delivery_count": 2, "accepted_count": 1, "total": 3, "missing_ids": ["r2"]}
    }
  ]
}
