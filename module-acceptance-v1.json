  "cases": [
    {
      "case_id": "normal",
      "expected": {"status": "completed", "total": 3, "missing_ids": ["r2"]}
    },
    {
      "case_id": "unknown-dataset",
      "input_override": {"dataset_id": "absent"},
      "expected": {"status": "failed", "error_code": "dataset_not_found", "failed_step": "read"}
