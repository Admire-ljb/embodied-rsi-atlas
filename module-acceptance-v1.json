{
  "fixture_version": "1.0",
  "description": "离线仪表巡检示例。字段是应用层约定，由各模块映射到所用协议。expected 只供测试断言使用。",
  "application_version": "inspection@1.0",
  "run_id": "example-run-01",
  "task": {
    "task_id": "inspect-readings",
    "request": "汇总本批读数，列出缺失读数的记录编号。",
    "dataset_id": "readings-v1"
  },
  "records": [
    {"record_id": "r1", "reading": 21},
    {"record_id": "r2", "reading": null},
    {"record_id": "r3", "reading": 0}
  ],
  "skill_catalog": [
    {"name": "load_readings", "version": "1.0", "inputs": ["dataset_id"], "outputs": ["records"]},
    {"name": "summarize_readings", "version": "1.0", "inputs": ["records"], "outputs": ["summary"]}
  ],
  "reference_plan": [
    {"step_id": "read", "skill": "load_readings", "depends_on": []},
    {"step_id": "summarize", "skill": "summarize_readings", "depends_on": ["read"]}
