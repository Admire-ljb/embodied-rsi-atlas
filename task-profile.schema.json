{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "具身 RSI 任务描述 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "version",
          "title",
          "status",
          "objective",
          "environment",
          "entities",
          "time_basis",
          "observations",
          "capabilities",
          "feedback",
          "reference",
          "metrics",
          "first_artifact"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "entities": {
            "type": "string",
            "minLength": 1
          },
          "time_basis": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "string",
            "minLength": 1
          },
          "feedback": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "string",
            "minLength": 1
          },
          "first_artifact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
